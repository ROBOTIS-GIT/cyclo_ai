{
  "name": "cyclo-ai-source",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node tests/run.mjs",
    "test:integration": "node --test tests/integration.test.mjs",
    "validate": "node scripts/python.mjs validation/validate_package.py",
    "package": "node scripts/python.mjs validation/package_release.py",
    "test:products": "node --test tests/dynamixel.test.mjs tests/selection.test.mjs tests/products-integration.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/setup.mjs",
    "package:manifest": "node scripts/python.mjs validation/package_release.py --refresh-manifest",
    "format": "prettier --write \"modules/**/*.mjs\" \"scripts/*.mjs\" \"tests/**/*.mjs\"",
    "format:check": "prettier --check \"modules/**/*.mjs\" \"scripts/*.mjs\" \"tests/**/*.mjs\"",
    "format:python": "node scripts/python.mjs -m ruff format modules scripts validation",
    "format:python:check": "node scripts/python.mjs -m ruff format --check modules scripts validation",
    "package:runtime": "node scripts/python.mjs validation/package_runtime.py",
    "verify:runtime": "node scripts/python.mjs validation/verify_runtime.py"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "esbuild": "0.28.2",
    "prettier": "3.6.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.3.6"
  },
  "license": "Apache-2.0"
}
