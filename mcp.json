{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "cyclo-firmware": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/modules/firmware/launch.mjs"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "CYCLO_PLUGIN_ENABLE_HARDWARE": "0"
      }
    },
    "cyclo-products": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/modules/dynamixel/server.mjs"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "CYCLO_PRODUCTS_ENABLE_HARDWARE": "0"
      }
    }
  }
}
